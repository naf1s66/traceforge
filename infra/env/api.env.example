# Go API env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/traceforge?sslmode=disable

# Required keys
WRITE_API_KEY=dev-write-key
PUBLIC_READ_API_KEY=dev-public-read-key

# Rate limits
RATE_LIMIT_WRITE_PER_MINUTE=60
RATE_LIMIT_PUBLIC_READ_PER_5M=10

# Public demo workspace (used by demo UI)
PUBLIC_WORKSPACE_ID=public
